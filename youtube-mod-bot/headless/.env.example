# Anthropic key, only needed when qa.enabled is true.
ANTHROPIC_API_KEY=sk-ant-...

# YouTube session cookies for the account that moderates the chat.
# In a signed-in youtube.com tab: DevTools > Application > Cookies.
# These are live credentials for that Google account — treat them like a
# password, keep this file out of git, and sign the account out to revoke them.
SAPISID=
APISID=
HSID=
SID=
SSID=

# Dashboard access. Without a token the dashboard binds to 127.0.0.1 only and
# cannot be reached from your phone. Set a long random one to expose it:
#   openssl rand -hex 24
# It is plain HTTP, so put it behind a VPN (Tailscale), an SSH tunnel, or an
# HTTPS reverse proxy rather than straight onto a public IP.
DASHBOARD_TOKEN=
