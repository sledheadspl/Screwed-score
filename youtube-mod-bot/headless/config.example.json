{
  "channel": "@yourhandle",
  "pollSeconds": 60,
  "model": "claude-sonnet-5",

  "moderation": {
    "enabled": true,
    "mode": "dry",
    "holdSeconds": 25,
    "holdDefault": "skip",

    "standing": {
      "categories": {
        "hate":       { "enabled": true, "action": "ban",     "words": [] },
        "harassment": { "enabled": true, "action": "timeout" },
        "doxxing":    { "enabled": true, "action": "ban" },
        "spamLinks":  { "enabled": true, "action": "timeout" }
      }
    },

    "judgment": {
      "words": ["fuck", "shit", "bitch", "asshole"],
      "patterns": [],
      "onMatch": "act",
      "lenientForMembers": true
    },

    "allowList": [],
    "strikes": { "enabled": true, "timeoutAt": 2, "banAt": 3 },
    "respectHumanMods": true
  },

  "qa": {
    "enabled": true,
    "trigger": "prefix",
    "prefix": "!ask",
    "cooldownSeconds": 20,
    "maxRepliesPerHour": 60,
    "mentionAsker": true,
    "skipOwnerMessages": true,
    "maxReplyChars": 190
  },

  "dashboard": { "enabled": true, "port": 8787 }
}
